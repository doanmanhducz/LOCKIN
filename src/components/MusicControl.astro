---
const { src } = Astro.props;
---
<audio class="background-music" src={src} loop preload="auto"></audio>
<button class="music-toggle" type="button" aria-label="Play background music" aria-pressed="false"><span aria-hidden="true">♫</span></button>
<section class="sound-gate" data-sound-gate role="dialog" aria-modal="true" aria-labelledby="sound-gate-title" hidden>
  <div class="sound-gate-panel">
    <p> SYSTEM AUDIO LOCKED</p>
    <h2 id="sound-gate-title">Click to enter with sound</h2>
    <button class="button button-solid" type="button" data-enable-audio>ENTER // ENABLE AUDIO</button>
    <p class="sound-gate-error" data-audio-error hidden>Audio unavailable. Continue without sound.</p>
    <button class="sound-gate-continue" type="button" data-continue-silent hidden>Continue without sound</button>
  </div>
</section>

<script>
  const audio = document.querySelector<HTMLAudioElement>('.background-music');
  const button = document.querySelector<HTMLButtonElement>('.music-toggle');
  const gate = document.querySelector<HTMLElement>('[data-sound-gate]');
  const enableButton = document.querySelector<HTMLButtonElement>('[data-enable-audio]');
  const continueButton = document.querySelector<HTMLButtonElement>('[data-continue-silent]');
  const errorMessage = document.querySelector<HTMLElement>('[data-audio-error]');

  if (audio && button && gate && enableButton && continueButton && errorMessage) {
    const enabledKey = 'musicEnabled';
    const volumeKey = 'musicVolume';
    let enabled: boolean | null = null;

    try {
      const saved = localStorage.getItem(enabledKey);
      enabled = saved === null ? null : saved === 'true';
      const savedVolume = Number(localStorage.getItem(volumeKey));
      audio.volume = Number.isFinite(savedVolume) && savedVolume >= 0 && savedVolume <= 1 ? savedVolume : 0.25;
    } catch {
      audio.volume = 0.25;
    }
    audio.muted = false;

    const updateButton = (playing: boolean) => {
      button.classList.toggle('is-playing', playing);
      button.setAttribute('aria-pressed', String(playing));
      button.setAttribute('aria-label', playing ? 'Pause background music' : 'Play background music');
    };
    const persist = (next: boolean) => {
      enabled = next;
      try {
        localStorage.setItem(enabledKey, String(next));
        localStorage.setItem(volumeKey, String(audio.volume));
      } catch {
        // Private browsing can block persistent storage.
      }
    };
    const dismissGate = () => {
      gate.classList.add('is-leaving');
      setTimeout(() => gate.remove(), 250);
    };
    const showGate = () => {
      gate.hidden = false;
      enableButton.focus();
    };
    const showAudioError = () => {
      errorMessage.hidden = false;
      continueButton.hidden = false;
      enableButton.hidden = true;
    };
    const play = async () => {
      try {
        await audio.play();
        persist(true);
        updateButton(true);
        return true;
      } catch {
        updateButton(false);
        return false;
      }
    };
    const toggleMusic = async () => {
      if (!audio.paused) {
        audio.pause();
        persist(false);
        updateButton(false);
        return;
      }
      if (!(await play())) showGate();
    };
    const enableAudio = async () => {
      if (await play()) dismissGate();
      else showAudioError();
    };
    const continueSilently = () => {
      persist(false);
      dismissGate();
    };
    const cleanup = () => {
      button.removeEventListener('click', toggleMusic);
      enableButton.removeEventListener('click', enableAudio);
      continueButton.removeEventListener('click', continueSilently);
      document.removeEventListener('astro:before-swap', cleanup);
    };

    updateButton(false);
    button.addEventListener('click', toggleMusic);
    enableButton.addEventListener('click', enableAudio);
    continueButton.addEventListener('click', continueSilently);
    document.addEventListener('astro:before-swap', cleanup, { once: true });

    if (enabled !== false) void play().then((didPlay) => {
      if (!didPlay) showGate();
    });
  }
</script>
