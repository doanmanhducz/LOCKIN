---
import '../styles/global.css';
import { portfolioNavigation, site } from '../config/site';
import { sitePath } from '../lib/paths';
const { title, description = site.summary, currentPath = '/' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inconsolata:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title} | {site.name}</title>
  </head>
  <body>
    <div class="network" aria-hidden="true"></div><div class="scanlines" aria-hidden="true"></div>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={sitePath('/#home')} aria-label="Your Name home"><span>[</span>YourName<span>]</span></a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="Open navigation"><i></i><i></i><i></i></button>
        <nav class="site-nav" id="site-menu" aria-label="Primary navigation">
          {portfolioNavigation.map((item) => { const active = item.href === '#home' ? currentPath === '/' : !item.href.startsWith('#') && currentPath.startsWith(item.href); return <a href={sitePath(item.href.startsWith('#') ? `/${item.href}` : item.href)} aria-current={active ? 'page' : undefined}>{item.label}</a>; })}
        </nav>
      </div>
    </header>
    <main id="content"><slot /></main>
    <footer class="site-footer"><p>© 2026 Your Name. Built with intent, kept public.</p></footer>
    <button class="back-to-top" type="button" aria-label="Back to top">↑</button>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('.site-nav');
      const topButton = document.querySelector<HTMLButtonElement>('.back-to-top');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('is-open', !open);
      });
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        toggle?.setAttribute('aria-expanded', 'false'); nav?.classList.remove('is-open');
      }));
      addEventListener('scroll', () => topButton?.classList.toggle('is-visible', scrollY > 560), { passive: true });
      topButton?.addEventListener('click', () => scrollTo({ top: 0, behavior: 'smooth' }));
    </script>
  </body>
</html>
