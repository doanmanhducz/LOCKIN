---
import '../styles/global.css';
import { navigation, site } from '../config/site';
import { sitePath } from '../lib/paths';
const { title, description = site.summary, currentPath = '' } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Inconsolata:wght@400;600;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet"/><title>{title} | {site.name}</title></head><body><div class="terminal-grid" aria-hidden="true"></div><div class="scanlines" aria-hidden="true"></div><a class="skip" href="#content">Skip to content</a><div class="shell"><header class="terminal-bar"><a class="brand mono" href={sitePath('/')}>[ DOAN_DOKJA ]</a><span class="terminal-id mono">{site.terminalIdentity}</span><nav class="nav mono">{navigation.map((item)=><a href={sitePath(item.href)} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>)}</nav></header><main id="content"><slot /></main><footer class="section mono muted">[ EOF ] research notes, not a product brochure.</footer></div></body></html>
