---
import '../styles/global.css';
import { navigation, site } from '../config/site';
import { sitePath } from '../lib/paths';
const { title, description = site.summary, currentPath = '' } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><title>{title} | {site.name}</title></head><body><a class="skip" href="#content">Skip to content</a><div class="shell"><header><a class="brand mono" href={sitePath('/')}>[ DOAN DOKJA / FIELD NOTES ]</a><nav class="nav mono">{navigation.map((item)=><a href={sitePath(item.href)} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>)}</nav></header><main id="content"><slot /></main><footer class="section mono muted">Notes from the work. No borrowed mythology.</footer></div></body></html>
