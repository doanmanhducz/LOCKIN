---
import BaseLayout from '../layouts/BaseLayout.astro';
import { portfolio } from '../config/site';
---
<BaseLayout title="Security Research Portfolio" currentPath="/">
  <section class="hero" id="home" aria-labelledby="hero-title">
    <div class="terminal-window">
      <div class="terminal-titlebar"><span class="traffic"><i></i><i></i><i></i></span><span>yourname@portfolio:~$</span></div>
      <div class="terminal-body">
        <p class="command">$ whoami</p>
        <h1 id="hero-title"><span class="type-name">Your Name <em>"Alias"</em></span><b aria-hidden="true">_</b></h1>
        <p class="command">$ cat roles.txt</p>
        <p class="hero-roles">{portfolio.roles}</p>
        <p class="hero-copy">{portfolio.introduction}</p>
        <div class="hero-actions"><a class="button button-solid" href="#projects">Explore My Work</a><a class="button button-outline" href="#certifications">View Credentials</a></div>
      </div>
    </div>
  </section>

  <section class="section reveal" id="skills" aria-labelledby="skills-title">
    <header class="section-title"><p>$ ls ~/skills</p><h2 id="skills-title">What I work with</h2><i></i></header>
    <div class="skills-grid">{portfolio.skillGroups.map((group) => <article class="skill-card"><h3>{group.title}</h3><ul>{group.items.map((item) => <li>{item}</li>)}</ul></article>)}</div>
  </section>

  <section class="section reveal" id="certifications" aria-labelledby="certifications-title">
    <header class="section-title"><p>$ find ./credentials -type f</p><h2 id="certifications-title">Certifications</h2><i></i></header>
    <div class="cert-groups">{['Security Foundations', 'Offensive Practice'].map((category) => <div class="cert-category"><h3>{category}</h3><div class="cert-grid">{portfolio.certifications.filter((cert) => cert.category === category).map((cert) => <button class="cert-card" type="button" data-cert={cert.id} aria-haspopup="dialog"><span class:list={['certificate-art', cert.tone]} aria-hidden="true"><b>VERIFIED</b><small>{cert.issuer}</small></span><strong>{cert.title}</strong><span>View Certificate →</span></button>)}</div></div>)}</div>
  </section>

  <section class="section reveal" id="projects" aria-labelledby="projects-title">
    <header class="section-title"><p>$ ls ~/projects</p><h2 id="projects-title">Selected projects</h2><i></i></header>
    <div class="project-grid">{portfolio.projects.map((project) => <article class="project-card"><div><h3>{project.title}</h3><p>{project.description}</p><div class="tags">{project.tags.map((tag) => <span>{tag}</span>)}</div></div><a class="button button-outline" href="#contact">View Project</a></article>)}</div>
    <p class="section-action"><a class="button button-outline" href="#contact">View More on GitHub</a></p>
  </section>

  <section class="section contact-section reveal" id="contact" aria-labelledby="contact-title">
    <header class="section-title"><p>$ ping collaborator</p><h2 id="contact-title">Contact</h2><i></i></header>
    <div class="contact-card"><p>For thoughtful security research, useful systems, and difficult questions.</p><dl><div><dt>EMAIL</dt><dd><a href={portfolio.contact.email}>{portfolio.contact.label}</a></dd></div><div><dt>LOCATION</dt><dd>{portfolio.contact.location}</dd></div><div><dt>STATUS</dt><dd>{portfolio.contact.availability}</dd></div></dl></div>
  </section>

  <dialog class="certificate-dialog" aria-labelledby="certificate-title"><button class="dialog-close" type="button" aria-label="Close certificate dialog">×</button><div class="dialog-art" aria-hidden="true"><span>PORTFOLIO CREDENTIAL</span><b>VERIFIED</b></div><p class="dialog-kicker">Certificate preview</p><h2 id="certificate-title"></h2><p class="dialog-description"></p><a class="button button-outline dialog-link" href="#certifications">Open Full Image ↗</a></dialog>
  <script is:inline id="certificate-data" type="application/json" set:html={JSON.stringify(portfolio.certifications)}></script>
  <script>
    type Certificate = { id: string; title: string; description: string };
    const certifications = JSON.parse(document.querySelector('#certificate-data')?.textContent || '[]') as Certificate[];
    const dialog = document.querySelector<HTMLDialogElement>('.certificate-dialog');
    const title = dialog?.querySelector('#certificate-title');
    const description = dialog?.querySelector('.dialog-description');
    document.querySelectorAll('[data-cert]').forEach((button) => button.addEventListener('click', () => {
      const certificate = certifications.find((item) => item.id === button.getAttribute('data-cert'));
      if (!certificate || !(dialog instanceof HTMLDialogElement)) return;
      if (title) title.textContent = certificate.title;
      if (description) description.textContent = certificate.description;
      dialog.showModal();
    }));
    dialog?.querySelector('.dialog-close')?.addEventListener('click', () => dialog.close());
    dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const reveal = document.querySelectorAll('.reveal');
    if (reduceMotion) reveal.forEach((section) => section.classList.add('is-visible'));
    if (!reduceMotion) { const observer = new IntersectionObserver((entries, current) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); current.unobserve(entry.target); } }), { threshold: .12 }); reveal.forEach((section) => observer.observe(section)); }
  </script>
</BaseLayout>
