---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PortraitPlaceholder from '../components/PortraitPlaceholder.astro';
import ResearchCard from '../components/ResearchCard.astro';
import { sitePath } from '../lib/paths';
const recent = (await getCollection('research', ({ data }) => !data.draft)).sort((a,b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()).slice(0,3);
---
<BaseLayout title="Field Notes"><section class="hero"><div><p class="mono muted">RESEARCHER / SECURITY PRACTITIONER / WRITER</p><h1>I look for the seam before it splits.</h1><p class="lede">I work between AI security research and the practical mess of finding what systems leave exposed. The notes here are the parts worth keeping after the report is closed.</p><a class="stamp mono" href={sitePath('/about')}>READ THE NOTE</a></div><PortraitPlaceholder /></section><section class="section"><div class="section-head"><h2>Research notes</h2><a class="mono muted" href={sitePath('/research')}>VIEW THE ARCHIVE</a></div><div class="card-list">{recent.map((entry) => <ResearchCard entry={entry} />)}</div></section></BaseLayout>
