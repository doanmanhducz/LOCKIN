---
import BaseLayout from '../layouts/BaseLayout.astro';
import { portfolio, site } from '../config/site';
import { sitePath } from '../lib/paths';
import { postPath } from '../lib/posts';
import { cveRecords, cveNumber } from '../data/cves';
---
<BaseLayout title="Security Research Portfolio" currentPath="/">
  <section class="hero" id="home" aria-labelledby="hero-title">
    <div class="terminal-window">
      <div class="terminal-titlebar"><span class="traffic"><i></i><i></i><i></i></span><span>{site.terminalIdentity}</span></div>
      <div class="terminal-body">
        <p class="command">$ whoami</p>
        <h1 id="hero-title"><span class="type-name">{site.name} <em>"{site.nickname}"</em></span><b aria-hidden="true">_</b></h1>
        <p class="command">$ cat roles.txt</p>
        <p class="hero-roles">{portfolio.roles}</p>
        <p class="hero-copy">{portfolio.introduction}</p>
        <div class="hero-actions"><a class="button button-solid" href="#projects">Explore My Work</a><a class="button button-outline" href="#certifications">View Credentials</a></div>
      </div>
    </div>
  </section>

  <section class="section reveal" id="skills" aria-labelledby="skills-title">
    <header class="section-title"><p>$ ls ~/skills</p><h2 id="skills-title">Skills</h2><i></i></header>
    <div class="skills-grid">{portfolio.skillGroups.map((group) => <article class:list={['skill-card', { others: group.title === 'Others' }]}><h3>{group.title}</h3><ul>{group.items.map((item) => <li>{item}</li>)}</ul></article>)}</div>
  </section>

  <section class="section reveal" id="research" aria-labelledby="research-title">
    <header class="section-title"><p>$ cat cves.log</p><h2 id="research-title">Research</h2><i></i></header>
    <div class="cve-table-wrap"><table class="cve-table"><thead><tr><th><button class="cve-sort-button" id="cve-sort-toggle" type="button" aria-label="Sort CVE numbers from oldest to newest" aria-sort="ascending">CVE Number <span aria-hidden="true">↑</span></button></th><th><div class="cve-filter" data-filter="program"><button class="cve-filter-button" type="button" aria-expanded="false">Program <span aria-hidden="true">▾</span></button><div class="cve-filter-menu" hidden>{Array.from(new Set(cveRecords.map((record) => record.program))).sort().map((program) => <label><input type="checkbox" value={program} checked /> <span>{program}</span></label>)}</div></div></th><th><div class="cve-filter" data-filter="severity"><button class="cve-filter-button" type="button" aria-expanded="false">Severity <span aria-hidden="true">▾</span></button><div class="cve-filter-menu" hidden>{['Critical', 'High', 'Moderate', 'Low'].filter((severity) => cveRecords.some((record) => record.severity === severity)).map((severity) => <label><input type="checkbox" value={severity} checked /> <span>{severity}</span></label>)}</div></div></th></tr></thead><tbody id="cve-body">{[...cveRecords].sort((a, b) => cveNumber(a.cve) - cveNumber(b.cve)).map((record) => <tr data-cve={record.cve} data-program={record.program} data-severity={record.severity}><td>{record.writeup ? <a href={sitePath(postPath('writeup', record.writeup))}>{record.cve}</a> : <span class="pending-cve">{record.cve}</span>}</td><td>{record.program}</td><td><span class:list={['severity', `severity-${record.severity.toLowerCase()}`]}>{record.severity} {record.score}</span></td></tr>)}</tbody></table></div>
  </section>

  <section class="section reveal" id="certifications" aria-labelledby="certifications-title">
    <header class="section-title"><p>$ cat credentials.log</p><h2 id="certifications-title">Certifications & Achievements</h2><i></i></header>
    <div class="cert-groups"><article class="cert-category"><h3>Certifications</h3><p class="empty-state">No certificates indexed yet.</p></article><article class="cert-category"><h3>Achievements</h3><ul class="achievement-list">{portfolio.achievements.map((achievement) => <li>{achievement}</li>)}</ul></article></div>
  </section>

  <section class="section reveal" id="projects" aria-labelledby="projects-title">
    <header class="section-title"><p>$ ls ~/projects</p><h2 id="projects-title">Projects</h2><i></i></header>
    <div class="project-grid">{portfolio.projects.map((project) => <article class="project-card"><div><h3>{project.title}</h3><p>{project.description}</p><div class="tags"><span>{project.language}</span></div></div><a class="button button-outline" href={project.url} target="_blank" rel="noreferrer">View Project</a></article>)}</div>
  </section>

  <section class="section reveal" id="publications" aria-labelledby="publications-title">
    <header class="section-title"><p>$ cat publications.log</p><h2 id="publications-title">Publications</h2><i></i></header>
    <div class="publication-grid">{portfolio.publications.map((publication) => <article class="publication-card"><p class="publication-venue">{publication.venue}</p><h3>{publication.title}</h3><p>{publication.description}</p><a class="button button-outline" href={publication.url.startsWith('/') ? sitePath(publication.url) : publication.url} target="_blank" rel="noreferrer">{publication.linkLabel} â†—</a></article>)}</div>
  </section>

  <section class="section contact-section reveal" id="contact" aria-labelledby="contact-title">
    <header class="section-title"><p>$ ping collaborator</p><h2 id="contact-title">Contact</h2><i></i></header>
    <div class="contact-card"><p>If you think Bae Suzy is the prettiest Korean girl, ping me.</p><dl><div><dt>EMAIL</dt><dd><a href={portfolio.contact.email}>{portfolio.contact.label}</a></dd></div><div><dt>GITHUB</dt><dd><a href={portfolio.contact.github} target="_blank" rel="noreferrer">{portfolio.contact.githubLabel}</a></dd></div><div><dt>LINKEDIN</dt><dd><a href={portfolio.contact.linkedin} target="_blank" rel="noreferrer">{portfolio.contact.linkedinLabel}</a></dd></div></dl></div>
  </section>

  <script>
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const reveal = document.querySelectorAll('.reveal');
    if (reduceMotion) reveal.forEach((section) => section.classList.add('is-visible'));
    if (!reduceMotion) { const observer = new IntersectionObserver((entries, current) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); current.unobserve(entry.target); } }), { threshold: .12 }); reveal.forEach((section) => observer.observe(section)); }
  </script>
 <script>
  const cveBody = document.querySelector<HTMLElement>('#cve-body');
  const cveToggle = document.querySelector<HTMLButtonElement>('#cve-sort-toggle');
  const severityRank: Record<string, number> = { Low: 1, Moderate: 2, High: 3, Critical: 4 };
  const cveNumber = (cve: string) => { const match = cve.match(/-(\d+)$/); return match ? Number(match[1]) : Number.MAX_SAFE_INTEGER; };
  let cveAscending = true;
  const selectedValues = (filter: HTMLElement) => [...filter.querySelectorAll<HTMLInputElement>('input:checked')].map((input) => input.value);
  const applyCveView = () => {
    if (!cveBody) return;
    const activePrograms = selectedValues(document.querySelector<HTMLElement>('[data-filter="program"]')!);
    const activeSeverities = selectedValues(document.querySelector<HTMLElement>('[data-filter="severity"]')!);
    [...cveBody.querySelectorAll('tr')].forEach((row) => { row.hidden = !activePrograms.includes(row.dataset.program ?? '') || !activeSeverities.includes(row.dataset.severity ?? ''); });
    const rows = [...cveBody.querySelectorAll('tr')].sort((a, b) => { const diff = cveNumber(a.dataset.cve ?? '') - cveNumber(b.dataset.cve ?? ''); const rankDiff = (severityRank[a.dataset.severity ?? ''] ?? 0) - (severityRank[b.dataset.severity ?? ''] ?? 0); return (cveAscending ? diff : -diff) || rankDiff; });
    rows.forEach((row) => cveBody.appendChild(row));
  };
  cveToggle?.addEventListener('click', () => { cveAscending = !cveAscending; cveToggle.setAttribute('aria-sort', cveAscending ? 'ascending' : 'descending'); cveToggle.setAttribute('aria-label', `Sort CVE numbers ${cveAscending ? 'from oldest to newest' : 'from newest to oldest'}`); const arrow = cveToggle.querySelector('span'); if (arrow) arrow.textContent = cveAscending ? '↑' : '↓'; applyCveView(); });
  document.querySelectorAll<HTMLElement>('.cve-filter').forEach((filter) => { const button = filter.querySelector<HTMLButtonElement>('.cve-filter-button'); const menu = filter.querySelector<HTMLElement>('.cve-filter-menu'); button?.addEventListener('click', (event) => { event.stopPropagation(); const isOpen = !menu?.hasAttribute('hidden'); document.querySelectorAll<HTMLElement>('.cve-filter-menu').forEach((other) => other.hidden = true); document.querySelectorAll<HTMLButtonElement>('.cve-filter-button').forEach((other) => other.setAttribute('aria-expanded', 'false')); if (menu) menu.hidden = isOpen; button.setAttribute('aria-expanded', String(!isOpen)); }); menu?.querySelectorAll('input').forEach((input) => input.addEventListener('change', applyCveView)); });
  document.addEventListener('click', () => { document.querySelectorAll<HTMLElement>('.cve-filter-menu').forEach((menu) => menu.hidden = true); document.querySelectorAll<HTMLButtonElement>('.cve-filter-button').forEach((button) => button.setAttribute('aria-expanded', 'false')); });
  applyCveView();
</script>
</BaseLayout>
