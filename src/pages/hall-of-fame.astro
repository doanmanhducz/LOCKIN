---
import BaseLayout from '../layouts/BaseLayout.astro';
import { achievements, type AchievementKind } from '../data/hall-of-fame';
const groups: { kind: AchievementKind; label: string }[] = [{kind:'paper',label:'Public Papers'},{kind:'cve',label:'CVE Records'},{kind:'certification',label:'Credentials'},{kind:'acknowledgement',label:'Acknowledgements'},{kind:'career',label:'Career Path'}];
---
<BaseLayout title="Hall of Fame" currentPath="/hall-of-fame"><section class="section"><p class="mono muted">HALL OF FAME / STATUS: COMPILED</p><h1>A record, not a resume.</h1><p class="lede">Published work, disclosed findings, certifications, acknowledgements, and the path between them.</p></section>{groups.map(({kind,label}) => <section class="section"><h2>{label}</h2>{achievements.filter((item) => item.kind === kind).map((item) => <article class="achievement"><span class="meta">{item.date}<br/>{item.organization}</span><span><h3>{item.url ? <a href={item.url}>{item.title}</a> : item.title}</h3><p class="muted">{item.summary}</p></span></article>)}</section>)}</BaseLayout>
