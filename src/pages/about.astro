---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortraitPlaceholder from '../components/PortraitPlaceholder.astro';
import { site } from '../config/site';
---
<BaseLayout title="About" currentPath="/about"><section class="hero"><div><p class="mono muted">ABOUT / IDENTITY</p><h1>{site.name}<br/><span class="muted">{site.nickname}</span></h1><p class="lede">{site.summary}</p>{site.cvHref && <p><a class="stamp mono" href={site.cvHref}>DOWNLOAD CV</a></p>}</div><PortraitPlaceholder /></section><section class="section prose"><h2>What I care about</h2><p>I study systems where assumptions, incentives, and implementation meet. This page is deliberately spare: enough context for the work, and room for the person behind it.</p><h2>Elsewhere</h2><ul>{site.socialLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul></section></BaseLayout>
